{
  "name": "jsk-urja-tasks",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "web:desktop": "expo start --web --port 8000",
    "web:desktop:render": "cross-env EXPO_PUBLIC_MOBILE_API=production expo start --web --port 8000",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:apk": "eas build --platform android --profile preview --non-interactive",
    "build:apk:local": "eas build --platform android --profile local --non-interactive",
    "build:apk:staging": "eas build --platform android --profile staging --non-interactive",
    "build:apk:prod": "eas build --platform android --profile production --non-interactive"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@react-native-community/datetimepicker": "8.0.1",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/stack": "^6.3.29",
    "axios": "^1.7.9",
    "date-fns": "^3.6.0",
    "expo": "~51.0.0",
    "expo-build-properties": "~0.12.5",
    "expo-constants": "~16.0.2",
    "expo-device": "~6.0.2",
    "expo-notifications": "~0.28.19",
    "expo-print": "~13.0.1",
    "expo-secure-store": "~13.0.2",
    "expo-sharing": "~12.0.1",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.17.1",
    "react-native-modal": "^13.0.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1",
    "react-native-web": "~0.19.10",
    "react-native-webview": "13.8.6"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "babel-preset-expo": "~11.0.0",
    "cross-env": "^10.1.0",
    "expo-build-properties": "~0.12.5"
  }
