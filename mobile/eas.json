{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "local": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "local"
      }
    },
    "staging": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "staging"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
