{
    "name": "crm-backend",
    "version": "1.0.0",
    "description": "Backend API for CRM Application",
    "main": "src/index.js",
    "type": "module",
    "scripts": {
        "start": "node src/index.js",
        "start:ipv4": "node --dns-result-order=ipv4first src/index.js",
        "build": "echo 'No build needed'",
        "dev": "node scripts/fixUtf16Encoding.mjs && nodemon src/index.js",
        "dev:ipv4": "node scripts/fixUtf16Encoding.mjs && nodemon --exec \"node --dns-result-order=ipv4first\" src/index.js",
        "lint": "eslint .",
        "migrate:company-scope": "node src/scripts/backfillCompanyId.mjs",
        "migrate:to-company": "node src/scripts/migrateDataToCompany.mjs",
        "diag:customers": "node src/scripts/diagCustomerTenant.mjs",
        "test": "node --test test/*.test.js"
    },
    "dependencies": {
        "@whiskeysockets/baileys": "^7.0.0-rc.9",
        "adm-zip": "^0.5.17",
        "bcryptjs": "^3.0.3",
        "bwip-js": "^4.10.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "exceljs": "^4.4.0",
        "express": "^4.19.2",
        "helmet": "^7.1.0",
        "http-status": "^2.1.0",
        "joi": "^17.13.1",
        "jsonwebtoken": "^9.0.3",
        "moment": "^2.30.1",
        "mongoose": "^8.4.1",
        "morgan": "^1.10.0",
        "multer": "^2.0.2",
        "node-cron": "^4.2.1",
        "nodemailer": "^6.10.1",
        "pdfkit": "^0.17.2",
        "puppeteer": "^24.36.1",
        "qrcode": "^1.5.4",
        "socket.io": "^4.8.3",
        "winston": "^3.13.0"
    },
    "devDependencies": {
        "eslint": "^9.0.0",
        "nodemon": "^3.1.11"
    }
}
